{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pico/yapicoprobe: SystemView demo (release)",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "servertype": "openocd",
      "device": "STM32G030F6",
      "interface": "swd",
      "executable": "${workspaceFolder}/build/release/systemview_demo/firmware.elf",
      "armToolchainPath": "${config:cortex-debug.armToolchainPath}",
      "gdbPath": "${config:cortex-debug.gdbPath}",
      "serverpath": "${config:cortex-debug.openocdPath}",
      "searchDir": [
        "${config:armLessons.openocdScripts}"
      ],
      "configFiles": [
        "${workspaceFolder}/openocd/cmsis-dap.cfg"
      ],
      "rtos": "auto",
      "svdFile": "${config:armLessons.svdFile}",
      "runToEntryPoint": "main",
      "preLaunchTask": "G030: build trace release",
      "postLaunchCommands": [
        "set {unsigned int}0x40015808 = {unsigned int}0x40015808 | 0x00000002",
        "set {unsigned int}0x4001580c = {unsigned int}0x4001580c | 0x00040000"
      ],
      "rttConfig": {
        "enabled": true,
        "address": "0x20000000",
        "searchSize": 8192,
        "clearSearch": false,
        "polling_interval": 50,
        "decoders": [
          {
            "port": 0,
            "type": "console",
            "label": "FreeRTOS RTT console",
            "inputmode": "disabled"
          }
        ]
      }
    },
    {
